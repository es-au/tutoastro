---
import '../styles/global.css';

const tituloPagina = "Datos sobre mi";

const identidad = {
	nombre: "Raúl Esaú Garcia Lozano",
	pais: "México",
	fechaNacimiento: "13 de marzo de 2008",
	hobbies: ["Tocar la guitarra", "Extrañar a mi ex"],
	ideologia: "Derecha(we are charly kirk)",
};

const gustos = ["Musica","Deportes","Negocios","Mi ex"];

const happy = true;

const finished = false;

const goal = 3;

const colorgustos = "blue";

const coloridentidad = "dimgray";

const weightidentidad = "bold";

const sizeidentidad = "1.5rem";

const fontWeight = "bold";

const fontCase = "uppercase";
---
<html lang="es">

	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{tituloPagina} </title>
	</head>

	<body>
		<h1> {tituloPagina}</h1>
		
		<style define:vars={{ colorgustos, fontWeight, fontCase, coloridentidad, weightidentidad, sizeidentidad }}>

    	h1 {
        	color: darkblue;
        	font-size: 4rem;
    	}

		.gusto{
			color: var(--colorgustos);
			font-weight: var(--fontWeight);
			text-transform: var(--fontCase);
		}

		.identidad{
			color: var(--coloridentidad);
			font-weight: var(--weightidentidad);
			font-size: var(--sizeidentidad);
		}
    </style>

		<ul class="identidad">
			<li>Me llamo {identidad.nombre} (aunque algunos me llaman eduardo pero cada quien)</li>
			<li>Nací el {identidad.fechaNacimiento}</li>
			{identidad.hobbies.length >= 2 &&
				<li>Mis hobbies son: {identidad.hobbies[0]} y {identidad.hobbies[1]}</li>
			}
		</ul>
		<p>Mis gustos son: </p>
		<ul>
			{gustos.map((gusto) => <li class="gusto">{gusto}</li>)}
		</ul>
		<br>
		<a href="/">Volver al inicio</a>
		<br>
		<a href="/blog/">Primera entrada del blog de esaú</a>
		<br>
		{happy && <p>¡Estoy feliz</p>}

		{finished && <p>¡He terminado este tutorial!</p>}

		{goal === 3 ? <p>Mi objetivo es llevarle mariachi a mi ex en 3 días.</p> : <p>Mi objetivo no son 3 días.</p>}
	</body>
</html>